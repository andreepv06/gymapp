# Copia questo file in ".env" (mai versionato) e compila i valori reali.

# Connection string Prisma per il PostgreSQL locale già installato.
# user=markfit, database=markfit, host=localhost, port=5432 (già verificati).
# Sostituisci SOLO la password con quella reale del ruolo "markfit".
DATABASE_URL="postgresql://markfit:CHANGE_ME@localhost:5432/markfit?schema=public"

PORT=3000

CORS_ORIGINS="http://localhost:5000,https://andreepv06.github.io"

JWT_SECRET="CHANGE_ME_LONG_RANDOM_STRING"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CHANGE_ME_LONG_RANDOM_STRING_2"
JWT_REFRESH_EXPIRES_IN="30d"

NODE_ENV="development"